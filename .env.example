# Demo mode is the default and needs no environment variables.
# The Vercel demo can stay in this mode without secrets.
#
# Production mode uses a Postgres/Supabase/Neon adapter and signed sessions:
# MAINTENANCE_MODE=postgres
# MAINTENANCE_AUTH_MODE=production
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# DIRECT_URL=postgresql://user:password@host/db?sslmode=require
# MAINTENANCE_SESSION_SECRET=replace-with-a-long-random-value
# NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
